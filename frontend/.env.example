# FastAPI backend base URL used by Next.js rewrites.
# The default local backend URL is http://localhost:8000.
BACKEND_URL=http://localhost:8000
# Optional BUILD-TIME check; unset negotiates a valid backend mode. Invalid or
# mismatched values lock workspace loading. A runtime change cannot fix a build.
# NEXT_PUBLIC_QUANTLAB_EXPECTED_MODE=read_only_demo

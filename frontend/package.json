{
  "name": "quantlab-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "e2e": "playwright test",
    "e2e:frozen": "playwright test e2e/frozen-demo.spec.ts e2e/scenario-studio.spec.ts e2e/pairs-ko-pep.spec.ts",
    "e2e:responsive": "playwright test e2e/responsive.spec.ts",
    "e2e:report": "playwright show-report ../artifacts/e2e/playwright-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:frontend": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.16.47",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
